// Prisma Schema for Darelkola Clinic CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Core Tables
// ===========================================

model Clinic {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]

  @@map("clinics")
}

model User {
  id        String   @id // Same ID as Supabase Auth user
  email     String   @unique
  name      String
  role      UserRole @default(RECEPTIONIST)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  preAssessments PreAssessment[]

  @@map("users")
}

// ASSISTANT is a clinician who examines the patient before the doctor does.
// Unlike Receptionist — a name attached to a shared login — he holds a real
// account, because he works from his own room on his own device and his notes
// are signed into the medical record.
enum UserRole {
  DOCTOR
  RECEPTIONIST
  ASSISTANT
}

// A named receptionist used purely to attribute actions (booking, patient
// registration, check-in). Distinct from a login User: the reception desk
// shares one login, and each action records which receptionist performed it.
// Managed by doctors in Settings. Deactivated (not deleted) to keep history.
model Receptionist {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookedAppointments    Appointment[] @relation("BookedBy")
  checkedInAppointments Appointment[] @relation("CheckedInBy")
  registeredPatients    Patient[]     @relation("RegisteredBy")

  @@map("receptionists")
}

// ===========================================
// Patient Management
// ===========================================

model Patient {
  id             String   @id @default(cuid())
  registeredById String?  @map("registered_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  personalHistory     PersonalHistory?
  previousMedications PreviousMedication[]
  investigations      Investigation[]
  investigationSheets InvestigationSheet[]
  preAssessments      PreAssessment[]
  sessions            Session[]
  appointments        Appointment[]
  registeredBy        Receptionist?        @relation("RegisteredBy", fields: [registeredById], references: [id])

  @@map("patients")
}

model PersonalHistory {
  id        String @id @default(cuid())
  patientId String @unique @map("patient_id")

  // Demographics
  fullName      String    @map("full_name")
  phoneNumber   String    @map("phone_number")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  sex           String?
  maritalStatus String?   @map("marital_status")
  offsprings    Int?
  occupation    String?
  residence     String?

  // Medical History (simple notes)
  presentHistory String? @map("present_history")
  pastHistory    String? @map("past_history")
  familyHistory  String? @map("family_history")

  // General Appearance
  built        String?
  behavior     String?
  intelligence String?
  facies       String?
  decubitus    String?

  // General Examination - Vitals
  bloodPressure String? @map("blood_pressure")
  pulse         String?
  supine        String?
  respRate      String? @map("resp_rate")
  temperature   String?

  // General Examination - Neck
  headAndNeck String? @map("head_and_neck")
  lymphNodes  String? @map("lymph_nodes")
  neckVeins   String? @map("neck_veins")
  thyroid     String?

  // General Examination - Limbs
  upperLimb       String? @map("upper_limb")
  lowerLimb       String? @map("lower_limb")
  peripheralPulse String? @map("peripheral_pulse")

  // General Examination - Systems
  cardioExam  String? @map("cardio_exam")
  chestExam   String? @map("chest_exam")
  abdomenExam String? @map("abdomen_exam")
  neuroExam   String? @map("neuro_exam")

  // Assessment
  provisionalDx String? @map("provisional_dx")
  comments      String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([phoneNumber])
  @@index([fullName])
  @@map("personal_histories")
}

model PreviousMedication {
  id        String @id @default(cuid())
  patientId String @map("patient_id")
  drug      String
  frequency String

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("previous_medications")
}

model Investigation {
  id        String   @id @default(cuid())
  patientId String   @map("patient_id")
  date      DateTime @db.Date
  invest    String
  report    String?
  fileUrl   String?  @map("file_url")
  fileName  String?  @map("file_name")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("investigations")
}

// ===========================================
// Sessions & Medications
// ===========================================

model Medication {
  id        String   @id @default(cuid())
  name      String   @unique
  dosage    String?
  form      String?
  createdAt DateTime @default(now()) @map("created_at")

  sessionMedications SessionMedication[]

  @@map("medications")
}

model Session {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  date        DateTime @db.Date
  examination String?

  // Vitals
  bloodPressure String? @map("blood_pressure")
  pulse         String?
  temperature   String?
  respRate      String? @map("resp_rate")

  createdAt DateTime @default(now()) @map("created_at")

  patient               Patient                @relation(fields: [patientId], references: [id])
  sessionMedications    SessionMedication[]
  sessionInvestigations SessionInvestigation[]
  investigationSheets   InvestigationSheet[]
  preAssessment         PreAssessment?

  @@index([patientId])
  @@map("sessions")
}

model SessionMedication {
  id           String  @id @default(cuid())
  sessionId    String  @map("session_id")
  medicationId String  @map("medication_id")
  active       Boolean @default(true)
  dosage       String?
  frequency    String?
  duration     String?
  notes        String?

  // Course dates for this drug on this patient. startedAt is stamped on the
  // first session the drug is prescribed and carried forward as the course
  // start; stoppedAt is stamped when the drug is deactivated and cleared if it
  // is reactivated. Both are nullable — old rows and the aggregation fall back
  // to inferring these from session dates (see buildMedSummaries).
  startedAt DateTime? @map("started_at") @db.Date
  stoppedAt DateTime? @map("stopped_at") @db.Date

  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id])

  @@unique([sessionId, medicationId])
  @@map("session_medications")
}

// The catalog of tests a doctor can request — labs, imaging, procedures. Grows
// as staff add new ones, exactly like the Medication catalog. Distinct from
// InvestigationSheet/Investigation, which hold *results*; this holds the names
// of things that can be *asked for*.
model InvestigationCatalog {
  id        String                @id @default(cuid())
  name      String                @unique
  category  InvestigationCategory @default(LAB)
  createdAt DateTime              @default(now()) @map("created_at")

  sessionInvestigations SessionInvestigation[]

  @@map("investigation_catalog")
}

enum InvestigationCategory {
  LAB
  IMAGING
  PROCEDURE
  OTHER
}

// A test the doctor requested during a session. Mirrors SessionMedication: it
// references the catalog and carries per-request detail. Starts REQUESTED
// (pending) and is flipped to RESULTED once the result comes back, so
// outstanding tests stay visible.
model SessionInvestigation {
  id              String                     @id @default(cuid())
  sessionId       String                     @map("session_id")
  investigationId String                     @map("investigation_id")
  status          SessionInvestigationStatus @default(REQUESTED)
  notes           String?
  requestedAt     DateTime                   @default(now()) @map("requested_at")
  resultedAt      DateTime?                  @map("resulted_at") @db.Date

  session       Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  investigation InvestigationCatalog @relation(fields: [investigationId], references: [id])

  @@unique([sessionId, investigationId])
  @@index([sessionId])
  @@map("session_investigations")
}

enum SessionInvestigationStatus {
  REQUESTED
  RESULTED
}

// The assistant doctor's pre-consultation note: vitals and his own examination,
// taken after check-in and before the doctor's session exists.
//
// It hangs off the Appointment — the visit — and never off the Patient. That is
// the one difference from InvestigationSheet below, and it is deliberate. A lab
// sheet is dated and carries forward, so an unclaimed one legitimately belongs
// to the next session. A pulse does not. Scoping to the visit is what stops a
// reading taken at a visit the patient abandoned from surfacing weeks later as
// though it were measured today.
//
// The session the doctor creates for that same appointment claims it. If the
// patient leaves first, it stays an assessment on that visit with no session,
// visible in the patient's history and claimable by nothing.
model PreAssessment {
  id            String  @id @default(cuid())
  patientId     String  @map("patient_id")
  appointmentId String  @unique @map("appointment_id")
  sessionId     String? @unique @map("session_id")
  assistantId   String? @map("assistant_id")

  // Vitals as the assistant measured them. The doctor's own readings live on
  // Session and stay empty unless he re-measures — nothing is ever copied
  // across, so a reading always carries the name of the man who took it.
  bloodPressure String? @map("blood_pressure")
  pulse         String?
  temperature   String?
  respRate      String? @map("resp_rate")

  examination String?

  // No `date`: the visit's date is the appointment's. The clinic works past
  // midnight, so a second source of truth for "which day was this" would
  // disagree with the appointment for the last hours of every shift.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient     @relation(fields: [patientId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assistant   User?       @relation(fields: [assistantId], references: [id])

  @@index([patientId])
  @@map("pre_assessments")
}

// Lab results. Entered by reception when the patient arrives — before the
// doctor's session exists — so these belong to the Patient, not the Session.
// The next session created for the patient claims any still-unlinked sheets,
// which is how a sheet ends up carrying the date of the session it arrived on.
model InvestigationSheet {
  id        String   @id @default(cuid())
  patientId String   @map("patient_id")
  sessionId String?  @map("session_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  // Hematology
  hb          Float?
  wbc         Float?
  neutrophils Float?
  lymphocytes Float?
  platelets   Float?
  esr         Float?
  crp         Float?

  // Biochemistry
  glucose         Float?
  glucosePP       Float? @map("glucose_pp")
  hba1c           Float?
  na              Float?
  k               Float?
  ca              Float?
  po4             Float?
  mg              Float?
  albumin         Float?
  sgot            Float?
  sgpt            Float?
  totalBilirubin  Float? @map("total_bilirubin")
  directBilirubin Float? @map("direct_bilirubin")
  ggt             Float?
  alp             Float?
  urea            Float?
  creatinine      Float?
  gfr             Float?
  uricAcid        Float? @map("uric_acid")
  cholesterol     Float?
  ldl             Float?
  hdl             Float?
  tg              Float?
  ft3             Float?
  ft4             Float?
  tsh             Float?
  pth             Float?

  // Urine
  urineRbc     Float?  @map("urine_rbc")
  pusCells     Float?  @map("pus_cells")
  crystals     String?
  urineAlb     String? @map("urine_alb")
  urinePC      String? @map("urine_pc")
  urineCulture String? @map("urine_culture")

  // Virology
  hbsAg String? @map("hbs_ag")
  hcAb  String? @map("hc_ab")
  hivAb String? @map("hiv_ab")

  // Drug Monitoring / Iron / PSA
  inr       Float?
  iron      Float?
  ferritin  Float?
  tibc      Float?
  tsat      Float?
  psaFree   Float?  @map("psa_free")
  psaTotal  Float?  @map("psa_total")
  psaRatio  Float?  @map("psa_ratio")
  drugLevel String? @map("drug_level")

  // Immunology
  ana     String?
  antiDna String? @map("anti_dna")
  c3      Float?
  c4      Float?
  rf      String?
  antiCcp String? @map("anti_ccp")
  ancaC   String? @map("anca_c")
  ancaP   String? @map("anca_p")
  spep    String?

  patient             Patient              @relation(fields: [patientId], references: [id])
  session             Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  extraInvestigations ExtraInvestigation[]

  @@index([patientId, date])
  @@index([sessionId])
  @@map("investigation_sheets")
}

model ExtraInvestigation {
  id      String  @id @default(cuid())
  sheetId String  @map("sheet_id")
  name    String
  result  String?

  sheet InvestigationSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@map("extra_investigations")
}

// ===========================================
// Appointment System
// ===========================================

model Appointment {
  id            String            @id @default(cuid())
  patientName   String            @map("patient_name")
  patientPhone  String            @map("patient_phone")
  patientId     String?           @map("patient_id")
  clinicId      String            @map("clinic_id")
  date          DateTime          @db.Date
  status        AppointmentStatus @default(SCHEDULED)
  type          AppointmentType   @default(REGULAR_EXAMINATION)
  queueNumber   Int?              @map("queue_number")
  checkedInAt   DateTime?         @map("checked_in_at")
  bookedById    String?           @map("booked_by_id")
  checkedInById String?           @map("checked_in_by_id")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  patient     Patient?      @relation(fields: [patientId], references: [id])
  bookedBy    Receptionist? @relation("BookedBy", fields: [bookedById], references: [id])
  checkedInBy Receptionist? @relation("CheckedInBy", fields: [checkedInById], references: [id])

  // Restrict, not Cascade: an appointment a clinician examined the patient at
  // is not a booking mistake, and deleting it must not silently take his note.
  preAssessment PreAssessment?

  @@unique([patientPhone, date, clinicId])
  @@index([clinicId, date, status])
  @@index([patientId])
  @@map("appointments")
}

// WITH_ASSISTANT is transient: the patient is in the assistant's room, so the
// doctor cannot call them. When the assistant is done they return to CHECKED_IN
// keeping their queue number. Whether they were pre-assessed is told by the
// PreAssessment row, not by a status — an assistant is often absent, and a
// patient reaching the doctor without one is normal.
enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  WITH_ASSISTANT
  WITH_DOCTOR
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentType {
  FAST_EXAMINATION
  REGULAR_EXAMINATION
  CONSULTATION
}
